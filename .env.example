# =============================================================================
# Finance AI — configuration
# install.sh crée automatiquement `.env` à partir de ce modèle (droits 600).
# Après une modification : `docker compose up -d` pour recharger la configuration.
# Ne commitez jamais `.env` : il contient vos secrets.
# =============================================================================

# Hash scrypt du mot de passe de connexion (format scrypt:<sel>:<hash>, jamais le mot de passe en clair).
# Pour le changer : ./scripts/set-password.sh
APP_PASSWORD_HASH=

# Secret de signature des sessions (au moins 32 caractères, aléatoire).
# Le changer déconnecte toutes les sessions ouvertes.
# Générer : openssl rand -hex 32
SESSION_SECRET=

# Clé API Claude (https://console.anthropic.com/). Optionnelle : sans clé, les fonctions IA
# sont désactivées proprement. Elle n'est jamais affichée dans l'interface.
# Les données consultées par l'assistant sont envoyées à l'API d'Anthropic.
ANTHROPIC_API_KEY=

# Modèle Claude utilisé par l'assistant.
CLAUDE_MODEL=claude-opus-5-5

# Fuseau horaire de l'application (dates du jour, mois en cours, instantanés quotidiens).
# Nom IANA : Europe/Paris (défaut), Europe/Brussels, America/Montreal…
TZ=Europe/Paris

# Port publié sur l'hôte (l'application écoute toujours sur 3000 dans le conteneur).
APP_PORT=3000

# Adresse d'écoute sur l'hôte : 0.0.0.0 = toutes les interfaces ;
# 127.0.0.1 = accessible uniquement en local (recommandé derrière un reverse proxy).
APP_BIND=0.0.0.0

# Attribut Secure du cookie de session :
#   auto  = Secure seulement si la requête arrive en HTTPS (X-Forwarded-Proto du proxy) ;
#   true  = toujours Secure (la connexion échouera en HTTP simple) ;
#   false = jamais Secure.
COOKIE_SECURE=auto

# Limitation des tentatives de connexion par adresse IP.
#   false = (défaut) un compteur unique pour tous les clients (5 échecs / 15 min).
#   true  = le client est identifié par la valeur la plus à droite de X-Forwarded-For.
# ATTENTION : ne mettez true QUE derrière un reverse proxy qui ajoute l'IP réelle du client
# (Caddy, Nginx, Traefik…) ET avec APP_BIND=127.0.0.1. Sinon n'importe qui peut forger
# cet en-tête et contourner la limite par IP.
TRUST_PROXY=false
